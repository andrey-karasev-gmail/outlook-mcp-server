{
  "name": "@web4w3/outlook-mcp-server",
  "version": "1.0.5",
  "description": "MCP server for Outlook.com email read/delete/mark operations via Microsoft Graph API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "outlook-mcp-server": "dist/index.js",
    "outlook-mcp-server-get-auth-token": "scripts/get-auth-token.js"
  },
  "files": [
    "dist",
    "scripts/get-auth-token.js",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/andrey-karasev-gmail/outlook-mcp-server.git"
  },
  "homepage": "https://web4w3.com/projects/outlook-mcp-server",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test tests/tokenManager.test.ts"
  },
  "keywords": [
    "mcp",
    "outlook",
    "microsoft-graph",
    "email"
  ],
  "license": "MIT",
  "dependencies": {
    "@azure/identity": "^4.3.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@modelcontextprotocol/sdk": "^1.18.0",
    "dotenv": "^17.4.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
