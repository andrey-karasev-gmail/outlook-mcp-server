# Microsoft Graph API Configuration for Outlook.com
# Get these values from https://portal.azure.com/

# OAuth 2.0 Configuration (for delegated permissions / user login)
# Use this for personal Outlook.com accounts
OUTLOOK_CLIENT_ID=your_client_id
OUTLOOK_CLIENT_SECRET=your_client_secret
OUTLOOK_TENANT_ID=common
OUTLOOK_REFRESH_TOKEN=your_refresh_token

# Alternative: For app-only authentication (less common for personal accounts)
# OUTLOOK_AUTH_TYPE=client-credentials
# OUTLOOK_TENANT_ID=your_tenant_id

# Email settings
OUTLOOK_MAILBOX=inbox
OUTLOOK_BATCH_SIZE=20

# MCP transport (optional)
# stdio = local use with an MCP client on the same machine (default)
# http  = serve Streamable HTTP on /mcp, for hosting (e.g. behind a tunnel);
#         MCP_HTTP_TOKEN is then required and sent as "Authorization: Bearer …"
MCP_TRANSPORT=stdio
# MCP_HTTP_PORT=3000
# MCP_HTTP_TOKEN=<redacted>
